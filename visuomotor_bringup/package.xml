<?xml version="1.0"?>
<?xml-model href="http://ros.org" schematypens="http://w3.org"?>
<package format="3">
  <name>visuomotor_bringup</name>
  <version>0.1.0</version>
  <description>Bringup package for specific hardware and simulation environments.</description>
  <maintainer email="brayandurantoconas@gmail.com">Brayan Durán Toconás</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- xArm5 real (scripts/xarm5_bridge.py, launch/xarm5_real.launch.py).
       xarm_api / xarm_msgs (xarm_ros2, rama humble) NO se declaran aquí a propósito: no están en rosdep
       y el equipo de simulación (Isaac Sim) no los necesita. En la Jetson los compila deploy/jetson/Dockerfile.jetson. -->
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>visuomotor_ros2</exec_depend>
  <exec_depend>visuomotor_data_collection</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
