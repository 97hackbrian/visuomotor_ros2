# ==============================================================================
# Dockerfile.jetson — Entorno de Inferencia Visuomotora en NVIDIA Jetson Orin Nano
# ==============================================================================
# Diseñado para JetPack 5.1.x (L4T R35.x) y actualizable a JetPack 6.x (L4T R36.x).
#
# Para JetPack 5 (L4T R35.4 / R35.6 con Kernel 5.10-tegra):
#   Base: dustynv/ros:humble-pytorch-l4t-r35.4.1 (Ubuntu 22.04 Jammy, Python 3.10, CUDA 11.4)
#
# Para JetPack 6 (L4T R36.x con Kernel 5.15-tegra):
#   Base: dustynv/ros:jazzy-pytorch-l4t-r36.2.0 (Ubuntu 24.04 Noble, Python 3.12, CUDA 12.2)
# ==============================================================================

ARG BASE_IMAGE=dustynv/ros:humble-pytorch-l4t-r35.4.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash
ENV PYTHONUNBUFFERED=1

# 1. Dependencias del sistema y de compilación ROS 2
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    git \
    curl \
    nano \
    libyaml-cpp-dev \
    libopencv-dev \
    python3-opencv \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-image-transport \
    && rm -rf /var/lib/apt/lists/*

# 2. Dependencias de Python para Visuomotor Core e Inferencia
# (PyTorch y Torchvision ya vienen preinstalados y acelerados por hardware en la imagen base)
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir \
    "safetensors>=0.4.0" \
    "huggingface_hub>=0.19.0" \
    "zarr>=2.14.2" \
    "coloredlogs>=15.0" \
    "humanize>=4.6.0" \
    "pyyaml>=6.0" \
    "diffusers>=0.21.0"

# 3. Estructura del Workspace ROS 2 para Inferencia Exclusiva
WORKDIR /ros_ws

# Copiar paquetes esenciales de inferencia (excluyendo recolección y datasets vía .dockerignore)
COPY visuomotor_msgs /ros_ws/src/visuomotor_msgs
COPY visuomotor_core /ros_ws/src/visuomotor_core
COPY visuomotor_ros2 /ros_ws/src/visuomotor_ros2

# Instalar visuomotor_core como paquete de Python en modo editable / sistema
RUN pip3 install --no-cache-dir -e /ros_ws/src/visuomotor_core

# 4. Compilación limpia del Workspace con Colcon
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build --symlink-install --packages-select visuomotor_msgs visuomotor_core visuomotor_ros2"

# 5. Punto de Entrada (Entrypoint) y Configuración de Red DDS
COPY deploy/jetson/entrypoint.sh /ros_ws/entrypoint.sh
RUN chmod +x /ros_ws/entrypoint.sh

# Crear directorio estándar para montar los pesos del modelo (/ros_ws/model)
RUN mkdir -p /ros_ws/model

WORKDIR /ros_ws
ENTRYPOINT ["/ros_ws/entrypoint.sh"]
CMD ["ros2", "launch", "visuomotor_ros2", "inference.launch.py"]
