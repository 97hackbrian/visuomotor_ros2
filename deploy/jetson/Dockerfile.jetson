# ==============================================================================
# Dockerfile.jetson — Entorno de Inferencia Visuomotora en NVIDIA Jetson Orin Nano
# ==============================================================================
# Imagen EXCLUSIVA PARA INFERENCIA del modelo en el robot (sin entrenamiento,
# recolección de datos ni RL). Incluye el driver del xArm5 real (xarm_ros2 humble)
# y el bringup visuomotor_bringup/launch/xarm5_real.launch.py.
#
# JetPack 5.1.x (L4T R35.x, kernel 5.10-tegra, CUDA 11.4):
#   Base: dustynv/ros:humble-desktop-pytorch-l4t-r35.4.1
#         Ubuntu 20.04 (focal), Python 3.8, PyTorch 2.0.0+nv23.05 con CUDA,
#         ROS 2 Humble compilado desde fuente en /opt/ros/humble/install
#         (ya incluye cv_bridge, tf2_ros, image_transport, message_filters y
#         rmw_cyclonedds_cpp).
#
# Para JetPack 6 (L4T R36.x, kernel 5.15-tegra):
#   Base: dustynv/ros:jazzy-pytorch-l4t-r36.2.0 (Ubuntu 24.04, Python 3.12, CUDA 12.2)
#   (en ese caso revisar las versiones fijadas de torchvision/diffusers abajo).
#
# Principio de diseño: NO se modifica el sistema base de la imagen (sin apt-get
# upgrade, sin actualizar pip ni paquetes del sistema como PyYAML/numpy/Pillow).
# Solo se añaden las dependencias de Python que faltan.
# ==============================================================================

ARG BASE_IMAGE=dustynv/ros:humble-desktop-pytorch-l4t-r35.4.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash
ENV PYTHONUNBUFFERED=1

# En la imagen base ROS vive en /opt/ros/${ROS_DISTRO}/install (no en /opt/ros/${ROS_DISTRO}).
ENV ROS_SETUP=/opt/ros/${ROS_DISTRO}/install/setup.bash

# 1. Dependencias de Python de inferencia (solo las que faltan en la imagen base).
#   - torch 2.0.0+nv23.05 (GPU) ya viene en la imagen: NO se reinstala.
#   - torchvision: la imagen no lo trae. La rueda aarch64 de PyPI 0.15.1 es la pareja de torch 2.0.0;
#     se instala con --no-deps para que pip no intente reemplazar el torch acelerado de NVIDIA.
#     (la advertencia "Failed to load image Python extension" es inocua: solo afecta a torchvision.io)
#   - diffusers 0.30.3: ultima serie compatible con torch 2.0.0 y Python 3.8
#     (0.36 exige torch.xpu y 0.27 exige huggingface_hub antiguo).
#   - PyYAML se deja el del sistema (5.3.1, instalado por distutils; pip no puede desinstalarlo).
RUN pip3 install --no-cache-dir --no-deps "torchvision==0.15.1" && \
    pip3 install --no-cache-dir \
        "safetensors>=0.4.0" \
        "huggingface_hub>=0.19.0" \
        "coloredlogs>=15.0" \
        "humanize>=4.6.0" \
        "einops" \
        "diffusers==0.30.3" \
        "transforms3d==0.4.2"

# 2. Driver oficial del xArm5 real (UFACTORY xarm_ros2, rama humble) en un workspace subyacente.
#   - Fijado por commit para que el build sea reproducible.
#   - control_msgs no viene en la imagen base y xarm_api lo necesita (acción GripperCommand).
#   - Solo se compilan los paquetes del driver (sin MoveIt, Gazebo ni RViz).
ARG XARM_ROS2_COMMIT=ac736c92b02de7ca7e0be6f737d77d46707464d8
ARG CONTROL_MSGS_COMMIT=4418bbf3efda12828795e4bb011742133c67a6e2
ENV XARM_WS=/opt/xarm_ws
RUN mkdir -p ${XARM_WS}/src && cd ${XARM_WS}/src && \
    git init -q xarm_ros2 && cd xarm_ros2 && \
    git remote add origin https://github.com/xArm-Developer/xarm_ros2.git && \
    git fetch -q --depth 1 origin ${XARM_ROS2_COMMIT} && git checkout -q FETCH_HEAD && \
    git submodule update -q --init --depth 1 xarm_sdk/cxx && \
    cd ${XARM_WS}/src && git init -q control_msgs && cd control_msgs && \
    git remote add origin https://github.com/ros-controls/control_msgs.git && \
    git fetch -q --depth 1 origin ${CONTROL_MSGS_COMMIT} && git checkout -q FETCH_HEAD && \
    cd ${XARM_WS} && /bin/bash -c "source ${ROS_SETUP} && \
        colcon build --packages-select control_msgs xarm_msgs xarm_sdk xarm_description xarm_api \
            --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF" && \
    rm -rf ${XARM_WS}/build ${XARM_WS}/log ${XARM_WS}/src

# 3. Workspace ROS 2 del proyecto (inferencia + bringup del xArm5 real)
WORKDIR /ros_ws

# Solo los paquetes necesarios (el resto se excluye vía .dockerignore)
COPY visuomotor_msgs /ros_ws/src/visuomotor_msgs
COPY visuomotor_core /ros_ws/src/visuomotor_core
COPY visuomotor_ros2 /ros_ws/src/visuomotor_ros2
COPY visuomotor_bringup /ros_ws/src/visuomotor_bringup

# visuomotor_core es Python puro (sin package.xml): se instala con pip, sin tocar torch.
RUN pip3 install --no-cache-dir --no-deps -e /ros_ws/src/visuomotor_core

# 4. Compilación del workspace con colcon sobre el driver xArm (visuomotor_core no es paquete ROS)
RUN /bin/bash -c "source ${ROS_SETUP} && source ${XARM_WS}/install/setup.bash && \
    colcon build --symlink-install --packages-select visuomotor_msgs visuomotor_ros2 visuomotor_bringup"

# 5. Punto de entrada y configuración de red DDS
COPY deploy/jetson/entrypoint.sh /ros_ws/entrypoint.sh
RUN chmod +x /ros_ws/entrypoint.sh

# Directorio estándar para montar los pesos del modelo (/ros_ws/model)
RUN mkdir -p /ros_ws/model

WORKDIR /ros_ws
ENTRYPOINT ["/ros_ws/entrypoint.sh"]
CMD ["ros2", "launch", "visuomotor_ros2", "inference.launch.py"]
