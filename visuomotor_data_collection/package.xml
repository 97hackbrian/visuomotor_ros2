<?xml version="1.0"?>
<?xml-model href="http://ros.org" schematypens="http://w3.org"?>
<package format="3">
  <name>visuomotor_data_collection</name>
  <version>0.1.0</version>
  <description>Data ingestion and processing for generative visuomotor policies.</description>
  <maintainer email="brayandurantoconas@gmail.com">Brayan Durán Toconás</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>rosbag2_py</depend>
  <depend>visuomotor_msgs</depend>
  <depend>tf2_ros_py</depend>

  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
